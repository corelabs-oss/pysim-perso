# setup.py imports this at build time to compute install_requires, so the
# sdist is unbuildable without it: building a wheel from the sdist failed
# with "ModuleNotFoundError: No module named 'gen_requirements'".
include gen_requirements.py

include README.md
include LICENSE
include settings.example.json

exclude settings.json
prune tests
